# Supabase — populated locally by `vercel env pull` once the Supabase Vercel integration is installed.
SUPABASE_URL=###
SUPABASE_ANON_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# Google OAuth — used by `supabase start` only (env() substitution in supabase/config.toml).
# Hosted Supabase reads Google credentials from Studio (Authentication → Providers → Google),
# not from Vercel env. The Astro app code never reads these directly.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=###
