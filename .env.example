# Supabase — populated locally by `vercel env pull .env`.
# Project: dchurjcpgzuoyunjsokl (Vercel-bound; the single consolidated project after S-01
# Prerequisites, per context/foundation/lessons.md rule #2). Reach its Studio via
# Vercel → Storage → "Open in Supabase".
SUPABASE_URL=###
SUPABASE_ANON_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# Google OAuth — optional locally. Hosted Supabase reads Google credentials from Studio
# (Authentication → Providers → Google), not from Vercel env or local .env. These keys
# are only consumed by `supabase start`'s env() substitution in supabase/config.toml,
# which is not part of the GameSlot dev loop after S-01 consolidation.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=###

# Web Push (F-02). Generate the keypair once via `npx web-push generate-vapid-keys --json`
# and store both here (dev) and in Vercel Env (Preview + Production). PUBLIC_VAPID_PUBLIC_KEY
# duplicates VAPID_PUBLIC_KEY — same string, different Astro schema slot so the client bundle
# can access it as import.meta.env.PUBLIC_VAPID_PUBLIC_KEY. VAPID_SUBJECT is a mailto: URI.
VAPID_PUBLIC_KEY=###
VAPID_PRIVATE_KEY=###
VAPID_SUBJECT=mailto:you@example.com
PUBLIC_VAPID_PUBLIC_KEY=###
