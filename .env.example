# Supabase — populated locally by `vercel env pull .env`.
# Project: dchurjcpgzuoyunjsokl (Vercel-bound; the single consolidated project after S-01
# Prerequisites, per context/foundation/lessons.md rule #2). Reach its Studio via
# Vercel → Storage → "Open in Supabase".
SUPABASE_URL=###
SUPABASE_ANON_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# Google OAuth — optional locally. Hosted Supabase reads Google credentials from Studio
# (Authentication → Providers → Google), not from Vercel env or local .env. These keys
# are only consumed by `supabase start`'s env() substitution in supabase/config.toml,
# which is not part of the GameSlot dev loop after S-01 consolidation.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=###
