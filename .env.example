# Supabase — populated locally by `vercel env pull` once the Supabase Vercel integration is installed.
SUPABASE_URL=###
SUPABASE_ANON_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# Google OAuth — created in Google Cloud Console, paste into Vercel env + Supabase Studio.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=###
