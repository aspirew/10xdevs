---
import Layout from "@/layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-tavern flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-amber-100/10 bg-amber-100/10 p-8 text-amber-50 backdrop-blur-xl"
    >
      <h1
        class="mb-6 bg-gradient-to-r from-amber-200 via-amber-300 to-orange-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      {
        error && (
          <p
            role="alert"
            class="mb-4 flex items-start gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
          >
            <span aria-hidden="true" class="font-bold">
              !
            </span>
            <span>{error}</span>
          </p>
        )
      }
      <form method="POST" action="/api/auth/oauth/google">
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-amber-100/20 bg-amber-100/10 px-4 py-2 text-sm font-medium text-amber-50 transition-colors hover:bg-amber-100/20"
        >
          Continue with Google
        </button>
      </form>
    </div>
  </div>
</Layout>
