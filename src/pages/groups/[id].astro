---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GroupCalendar from "@/components/GroupCalendar";
import { InstallPushBanner } from "@/components/InstallPushBanner";
import { createAdminClient } from "@/lib/supabase-admin";
import { getAvailabilityWindow, type AvailabilityWindow } from "@/lib/availability";
import { addDays, formatDate } from "@/lib/calendar";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/auth/signin?error=${encodeURIComponent("Please sign in")}`, 302);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/groups", 302);
}

const error = Astro.url.searchParams.get("error");
const admin = createAdminClient();

// Admin client + app-layer membership check replaces RLS "groups: members read" /
// "group_members: members read" — see /api/groups/index.ts for context on the
// auth.uid() platform issue. Privacy NFR preserved: "Group not found" rendered
// when the current user isn't a member (don't distinguish from "doesn't exist").
interface GroupWithMembers {
  id: string;
  name: string;
  invite_token: string;
  created_by: string;
  group_members: { user_id: string }[];
}

let group: { id: string; name: string; invite_token: string; created_by: string } | null = null;
let memberIds: string[] = [];
let groupError: string | null = null;

if (!admin) {
  groupError = "Supabase admin client is not configured";
} else {
  const { data, error: queryError } = await admin
    .from("groups")
    .select("id, name, invite_token, created_by, group_members(user_id)")
    .eq("id", id)
    // `.returns<T>()` works against admin queries the same way; deprecated but functional.
    // eslint-disable-next-line @typescript-eslint/no-deprecated
    .returns<GroupWithMembers[]>()
    .maybeSingle();
  if (queryError) {
    groupError = queryError.message;
  } else if (data) {
    const memberUserIds = data.group_members.map((m) => m.user_id);
    // App-layer membership check (replaces RLS USING).
    if (memberUserIds.includes(user.id)) {
      group = { id: data.id, name: data.name, invite_token: data.invite_token, created_by: data.created_by };
      memberIds = memberUserIds;
    }
  }
}

// Member emails come from auth.users — anon role has no access; the admin client's
// .auth.admin namespace IS the canonical way to read auth user records. Scoped to
// only the user_ids of this group.
let members: { id: string; email: string | null }[] = [];
if (group && admin && memberIds.length > 0) {
  const fetched = await Promise.all(
    memberIds.map(async (uid) => {
      const { data: userRecord } = await admin.auth.admin.getUserById(uid);
      return { id: uid, email: userRecord.user?.email ?? null };
    }),
  );
  members = fetched;
}

const inviteUrl = group ? `${Astro.url.origin}/invite/${group.invite_token}` : null;
const isCreator = group?.created_by === user.id;

// Initial 4-week availability window for the React calendar island.
// JS-level membership check above already gated; we can safely call the helper here
// with the admin client. (RLS isn't the gate on this project — see lessons.md.)
const today = new Date();
const startStr = formatDate(today);
const endStr = formatDate(addDays(today, 27));
let calendarInitial: AvailabilityWindow | null = null;
if (group && admin) {
  try {
    // Pass memberIds.length so the helper skips its own COUNT query — we already
    // have the size from the member-list pull above.
    calendarInitial = await getAvailabilityWindow(admin, group.id, user.id, startStr, endStr, memberIds.length);
  } catch {
    // Non-fatal: render the page without the calendar island if the read fails.
    // (Calendar simply won't render; user sees Members + Invite as before.)
  }
}
---

<Layout title={group ? group.name : "Group"}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar />

      <InstallPushBanner client:load />

      {
        !group && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Group not found
            </h1>
            <p class="text-sm text-blue-100/70">This group doesn't exist or you're not a member of it.</p>
            {groupError && (
              <p
                role="alert"
                class="mt-4 flex items-start gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
              >
                <span aria-hidden="true" class="font-bold">
                  !
                </span>
                <span>{groupError}</span>
              </p>
            )}
            <a href="/groups" class="mt-6 inline-block text-sm text-purple-300 hover:underline">
              Back to your groups
            </a>
          </div>
        )
      }

      {
        group && (
          <div class="space-y-6">
            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
              <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                {group.name}
              </h1>
              <p class="mt-1 text-sm text-blue-100/60">
                {members.length} {members.length === 1 ? "member" : "members"}
              </p>
            </div>

            {error && (
              <p
                role="alert"
                class="flex items-start gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
              >
                <span aria-hidden="true" class="font-bold">
                  !
                </span>
                <span>{error}</span>
              </p>
            )}

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-white backdrop-blur-xl">
              <h2 class="mb-3 text-lg font-semibold">Members</h2>
              <ul class="space-y-1 text-sm text-blue-100/80">
                {members.map((m) => (
                  <li class:list={m.id === user.id ? "font-semibold text-white" : ""}>
                    {m.email ?? m.id}
                    {m.id === user.id && <span class="ml-2 text-xs text-blue-100/50">(you)</span>}
                    {m.id === group.created_by && <span class="ml-2 text-xs text-purple-300">creator</span>}
                  </li>
                ))}
              </ul>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-white backdrop-blur-xl">
              <h2 class="mb-3 text-lg font-semibold">Invite link</h2>
              <p class="mb-3 text-sm text-blue-100/60">
                Share this link with friends. Anyone signed in who opens it joins this group.
              </p>
              <div class="flex gap-2">
                <input
                  id="invite-url"
                  type="text"
                  readonly
                  value={inviteUrl}
                  class="flex-1 rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none"
                />
                <button
                  id="copy-invite"
                  type="button"
                  class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
                >
                  Copy
                </button>
              </div>
              {isCreator && (
                <form method="POST" action={`/api/groups/${group.id}/regenerate-invite`} class="mt-4">
                  <button type="submit" class="text-sm text-purple-300 hover:underline">
                    Regenerate invite link (invalidates the current one)
                  </button>
                </form>
              )}
            </div>

            {calendarInitial && (
              <GroupCalendar client:load groupId={group.id} initial={calendarInitial} initialStart={startStr} />
            )}

            <p class="text-center text-sm text-blue-100/60">
              <a href="/groups" class="text-purple-300 hover:underline">
                Back to your groups
              </a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</Layout>

<script is:inline>
  const input = document.getElementById("invite-url");
  const button = document.getElementById("copy-invite");
  if (input instanceof HTMLInputElement && button) {
    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(input.value).then(() => {
        const original = button.textContent;
        button.textContent = "Copied!";
        setTimeout(() => {
          button.textContent = original;
        }, 1500);
      });
    });
  }
</script>
