---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-amber-100/10 bg-amber-100/5 px-4 py-2 text-sm text-amber-50/85"
>
  {
    user ? (
      <>
        <span class="text-amber-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/groups" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
            Groups
          </a>
          <a href="/install" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
            Notifications
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-amber-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/install" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
            Install
          </a>
          <a href="/auth/signin" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-amber-300 transition-colors hover:text-amber-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
