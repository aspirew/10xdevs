---
import Topbar from "@/components/Topbar.astro";
---

<div class="bg-tavern relative min-h-screen w-full overflow-hidden">
  <!-- Warm atmospheric orbs -->
  <div
    class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-amber-500/15 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-orange-500/10 blur-[100px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-emerald-400/10 blur-[140px]"
  >
  </div>

  <!-- Warm dust -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(circle, rgba(245,230,200,0.10) 1px, transparent 1px), radial-gradient(circle, rgba(245,230,200,0.06) 1px, transparent 1px), radial-gradient(circle, rgba(245,230,200,0.04) 1px, transparent 1px); background-size: 200px 200px, 150px 150px, 100px 100px; background-position: 0 0, 40px 60px, 80px 30px;"
  >
  </div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1
        class="mb-6 bg-gradient-to-r from-amber-200 via-amber-300 to-orange-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        GameSlot
      </h1>
      <p class="mb-10 max-w-2xl text-lg text-amber-100/80 sm:text-xl">
        Never miss a chance to play board games again.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-6 py-3 text-base font-medium text-emerald-950 transition-colors hover:bg-amber-400"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-lg border border-amber-100/25 px-6 py-3 text-base font-medium text-amber-50 transition-colors hover:bg-amber-100/10"
        >
          Sign up
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="rounded-xl border border-amber-100/10 bg-amber-50/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-amber-300"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-amber-50">Shared availability</h3>
        <p class="text-sm leading-relaxed text-amber-100/70">
          Every member marks the day+hour slots they can play, on one shared calendar for the group.
        </p>
      </div>

      <div class="rounded-xl border border-amber-100/10 bg-amber-50/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-amber-300"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-amber-50">Overlap at a glance</h3>
        <p class="text-sm leading-relaxed text-amber-100/70">
          The calendar highlights the slots the most members can make, so the host doesn't have to triangulate manually.
        </p>
      </div>

      <div class="rounded-xl border border-amber-100/10 bg-amber-50/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-amber-300"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-amber-50">Push on confirm</h3>
        <p class="text-sm leading-relaxed text-amber-100/70">
          The host confirms a slot with a location, and everyone in the group gets a push notification — no chat thread
          required.
        </p>
      </div>
    </div>
  </div>
</div>
